# Copy to .env for local development. In production, set these in the real environment.
# Only DJANGO_SECRET_KEY and DATABASE_URL are required; everything else has a default.

# ── Core ─────────────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
# Settings module: config.settings.dev (manage.py default) | config.settings.prod (wsgi default)
# DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=cms.example.com
# Admin lives here. Change it in production to keep it off scanners' default path.
DJANGO_ADMIN_URL=admin/

# ── Database (PostgreSQL) ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://shs_user:password@localhost:5432/shs_backend
DATABASE_CONN_MAX_AGE=60

# ── Cache ────────────────────────────────────────────────────────────────────────────
# Default is per-process memory. Use Redis in production (pip install redis) so the content
# cache and rate limits are shared between workers.
# CACHE_URL=redis://127.0.0.1:6379/1
CONTENT_CACHE_TIMEOUT=300

# ── Frontend / browser access ────────────────────────────────────────────────────────
# Where the Next.js site runs ("View site" link in the admin).
FRONTEND_URL=https://www.example.com
# Origins allowed to call the API from the browser (the contact form posts from there).
CORS_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://cms.example.com

# ── Media ────────────────────────────────────────────────────────────────────────────
DJANGO_MEDIA_ROOT=/var/www/shs/media
DJANGO_MEDIA_URL=/media/
# Where Admin > System status > Clean up unused files sets files aside (restorable).
# Default: <media root>/.trash. Keep it outside the folder the web server publishes.
# DJANGO_MEDIA_TRASH_ROOT=/var/www/shs/media-trash
# Public origin for media URLs in API responses. Required when the API is reached through
# an internal hostname or media is served from a CDN.
MEDIA_PUBLIC_BASE_URL=https://cms.example.com
MAX_IMAGE_UPLOAD_MB=8
MAX_VIDEO_UPLOAD_MB=60

# ── API ──────────────────────────────────────────────────────────────────────────────
API_THROTTLE_ANON=600/min
API_THROTTLE_ENQUIRIES=5/hour
API_THROTTLE_REVIEWS=5/hour
API_THROTTLE_ANALYTICS=120/min
# Visitor analytics older than this are removed by `manage.py prune_analytics`.
ANALYTICS_RETENTION_DAYS=180
# Number of reverse proxies in front of Django (for correct client IPs in rate limiting).
NUM_PROXIES=1

# ── Enquiries / e-mail ───────────────────────────────────────────────────────────────
# apps.enquiries.notifiers.EmailEnquiryNotifier | apps.enquiries.notifiers.NullEnquiryNotifier
ENQUIRY_NOTIFIER=apps.enquiries.notifiers.EmailEnquiryNotifier
# Fallback recipient when Site settings → "Send enquiries to" is empty.
ENQUIRY_NOTIFICATION_EMAIL=sales@example.com
ENQUIRY_DUPLICATE_WINDOW_MINUTES=10
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

# ── Security (prod settings) ─────────────────────────────────────────────────────────
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=2592000

# ── Logging ──────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# text | json (prod default: json)
LOG_FORMAT=text
