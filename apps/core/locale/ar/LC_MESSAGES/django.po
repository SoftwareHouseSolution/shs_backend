msgid "The request conflicts with the current state of the resource."
msgstr "يتعارض الطلب مع الحالة الحالية للمورد."

msgid "We have already received this message. There is no need to send it again."
msgstr "وصلتنا هذه الرسالة بالفعل، ولا داعي لإرسالها مرة أخرى."

msgid "The request could not be completed."
msgstr "تعذّر إتمام الطلب."

msgid "Too many requests. Please wait a moment and try again."
msgstr "طلبات كثيرة جدًا. يرجى الانتظار قليلًا ثم المحاولة مرة أخرى."

msgid "A service we depend on did not respond. Please try again shortly."
msgstr "لم تستجب إحدى الخدمات التي نعتمد عليها. يرجى المحاولة بعد قليل."

msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "الخدمة غير متاحة مؤقتًا. يرجى المحاولة بعد قليل."

msgid "An unexpected error occurred."
msgstr "حدث خطأ غير متوقع."

